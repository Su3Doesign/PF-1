{
  "name": "thesumanth",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Portfolio of Amidyala Sai Sumanth — an overgrown neon forest archive in WebGL.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "assets:content": "python3 tools/build_content.py",
    "assets:textures": "python3 tools/gen_textures.py",
    "assets:props": "python3 tools/blender/build_props.py && node tools/pack_3d.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource/shippori-mincho-b1": "^5.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/three": "^0.186.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  }
}
