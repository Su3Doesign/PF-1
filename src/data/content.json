 "steps": [
  [
   "Reference",
   "Look at the real thing for longer than is comfortable. Then keep looking."
  ],
  [
   "Blockout",
   "Grey boxes, honest proportions. If it is boring in clay it will be boring in colour."
  ],
  [
   "Hard-surface",
   "Edges that hold a highlight. Bevels you could run a thumb along."
  ],
  [
   "Sculpt",
   "Wear where hands have been. Nothing in a lived world is factory-new."
  ],
  [
   "Texture",
   "A working life: dust settles, paint chips, water always stains downward."
  ],
  [
   "Light",
   "One key that tells the truth. Everything after it is support and flattery."
  ],
  [
   "Comp",
   "Grade it, then remove half of what you just added."
  ]
 ],
